<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MudBlazor" Version="9.11.0" />
	</ItemGroup>
	<Target Name="CopyMudBlazorFiles" BeforeTargets="Build">
		<ItemGroup>
			<MudBlazorFiles Include="$(StaticWebAssetsBasePath)/**/mudblazor*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(MudBlazorFiles)" DestinationFolder="wwwroot/" SkipUnchangedFiles="true" />
	</Target>


</Project>
